{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EGA-archive/fega-metadata-schema/main/build/release_manifest.schema.json",
  "title": "FEGA metadata schema release manifest",
  "type": "object",
  "required": [
    "$schema",
    "manifest_version",
    "bundle_version",
    "tag",
    "release_date",
    "source_repository",
    "source_commit",
    "components",
    "standards"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_version": {
      "type": "integer",
      "minimum": 1
    },
    "bundle_version": {
      "$ref": "#/$defs/semver"
    },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "source_repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/standard"
      }
    }
  },
  "$defs": {
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "schema",
        "id",
        "version",
        "dependencies",
        "checksums"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "checksums": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/checksum"
          }
        }
      },
      "additionalProperties": false
    },
    "standard": {
      "type": "object",
      "required": [
        "name",
        "path",
        "sha256",
        "file_count"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/checksum"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}