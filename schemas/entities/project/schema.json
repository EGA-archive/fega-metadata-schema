  "$defs": {
    "fundingReference": {
      "type": "object",
      "title": "Funding reference",
      "description": "A funder supporting the Project and, when known, the award through which that support was provided.",
      "required": [
        "funder"
      ],
      "properties": {
        "funder": {
          "title": "Funder",
          "description": "The person or organisation providing financial support. Use a ROR URI or Crossref Funder Registry DOI as @id when available, or provide a name.",
          "meta:sssomMappings": [
            {
              "predicate_id": "skos:closeMatch",
              "object_id": "schema:funder",
              "mapping_justification": "semapv:ManualMappingCuration",
              "object_match_field": "rdfs:label",
              "subject_match_field": "rdfs:label",
              "author_id": ["orcid:0000-0002-7747-6256"],
              "creator_id": ["orcid:0000-0002-7747-6256"],
              "reviewer_id": [""],
              "confidence": 1.0,
              "mapping_date": "2026-09-23"
            }
          ],
          "allOf": [
            {
              "$ref": "../../common/schema.json#/$defs/agent"
            }
          ],
          "examples": [
            {
              "@type": [
                "prov:Agent",
                "prov:Organization"
              ],
              "@id": "https://commission.europa.eu/index_en",
              "name": "European Commission"
            },
            {
              "@type": [
                "prov:Agent",
                "prov:Organization"
              ],
              "name": "Eastmere Medical Research Foundation"
            }
          ]
        },

        "award": {
          "title": "Funding award",
          "description": "The award or grant supporting the Project. Omit this field when no award details are known.",
          "allOf": [
            {
              "$ref": "#/$defs/fundingAward"
            }
          ],
          "examples": [
            {
              "@id": "https://cordis.europa.eu/project/id/101137074",
              "number": "101137074",
              "title": "HEREDITARY",
              "url": "https://cordis.europa.eu/project/id/101137074"
            },
            {
              "number": "NRC-SEED-2026-0017",
              "title": "HeartGen pilot sequencing"
            }
          ]
        }
      },
      "examples": [
        {
          "funder": {
            "@type": [
              "prov:Agent",
              "prov:Organization"
            ],
            "@id": "https://commission.europa.eu/index_en",
            "name": "European Commission"
          },
          "award": {
            "@id": "https://cordis.europa.eu/project/id/101137074",
            "number": "101137074",
            "title": "HEREDITARY",
            "url": "https://cordis.europa.eu/project/id/101137074"
          }
        },
        {
          "funder": {
            "@type": [
              "prov:Agent",
              "prov:Organization"
            ],
            "name": "Eastmere Medical Research Foundation"
          }
        }
      ]
    },

    "fundingAward": {
      "type": "object",
      "title": "Funding award",
      "description": "Discovery metadata for a funding award or grant.",
      "meta:sssomMappings": [
        {
          "predicate_id": "skos:closeMatch",
          "object_id": "schema:Grant",
          "mapping_justification": "semapv:ManualMappingCuration",
          "object_match_field": "rdfs:comment",
