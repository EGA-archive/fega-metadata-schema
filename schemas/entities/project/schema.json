          "description": "A page describing the award on the funder's website or another authoritative service.",
          "meta:sssomMappings": [
            {
              "predicate_id": "skos:closeMatch",
              "object_id": "schema:url",
              "mapping_justification": "semapv:ManualMappingCuration",
              "object_match_field": "rdfs:label",
              "subject_match_field": "rdfs:label",
              "author_id": ["orcid:0000-0002-7747-6256"],
              "creator_id": ["orcid:0000-0002-7747-6256"],
              "reviewer_id": [""],
              "confidence": 1.0,
              "mapping_date": "2026-09-23"
            }
          ],
          "format": "uri",
          "examples": [
            "https://cordis.europa.eu/project/id/101137074"
          ]
        }
      },
      "examples": [
        {
          "@id": "https://cordis.europa.eu/project/id/101137074",
          "number": "101137074",
          "title": "HEREDITARY",
          "url": "https://cordis.europa.eu/project/id/101137074"
