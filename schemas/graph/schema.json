            { "type": "array", "title": "JSON-LD resource type (array)", "uniqueItems": true, "minItems": 1, "minContains": 1, "contains": { "$ref": "../common/schema.json#/$defs/relationshipItemRestrictionDataset/properties/@type/anyOf/0" }, "examples": [
                [
                  "ega:dataset"
                ]
              ] }
          ],
          "examples": [
            "ega:dataset"
          ]
        }
      },
      "examples": [
        {
          "@type": "ega:dataset"
        }
