        "@type": {
          "title": "JSON-LD resource type",
          "anyOf": [
            { "$ref": "../common/schema.json#/$defs/relationshipItemRestrictionDAC/properties/@type/anyOf/0" },
            { "type": "array", "title": "JSON-LD resource type (array)", "uniqueItems": true, "minItems": 1, "minContains": 1, "contains": { "$ref": "../common/schema.json#/$defs/relationshipItemRestrictionDAC/properties/@type/anyOf/0" }, "examples": [
