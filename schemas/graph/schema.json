          "fileName": "case2_case2_father_Case2_F.R1.fastq.gz",
          "fileFormat": {
            "id": "EDAM:format_1930",
            "label": "FASTQ"
          },
          "dataContent": {
            "id": "EDAM:data_2977",
            "label": "Nucleic acid sequence"
          },
          "checksums": [
            {
              "algorithm": "MD5",
              "value": "d41d8cd98f00b204e9800998ecf8427e",
              "appliesTo": "unencrypted"
            }
          ],
          "isPartOf": [
            {
              "@id": "ega:EGAD00000000002",
              "@type": [
                "ega:dataset",
                "dcat:Dataset"
              ]
            }
          ],
          "inSubmission": {
            "@id": "ega:EGA00000000001",
            "@type": "ega:submission"
          }
        }
      ]
    },

    "entitySchemaDataset": {
      "type": "object",
      "title": "Dataset entity validation",
      "if": {
        "allOf": [
          { "$ref": "#/$defs/declaresDataset" },
          { "$ref": "#/$defs/routableEntityType" }
