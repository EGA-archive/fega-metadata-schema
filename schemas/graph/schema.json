            { "type": "array", "title": "JSON-LD resource type (array)", "uniqueItems": true, "minItems": 1, "minContains": 1, "contains": { "$ref": "../common/schema.json#/$defs/relationshipItemRestrictionCohort/properties/@type/anyOf/0" }, "examples": [
                [
                  "ega:cohort"
                ]
              ] }
          ],
          "examples": [
            "ega:cohort"
          ]
        }
      },
      "examples": [
        {
          "@type": "ega:cohort"
        }
      ]
    },

    "declaresDAC": {
      "type": "object",
      "title": "Declares a DAC",
      "required": ["@type"],
