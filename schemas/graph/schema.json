          "@type": "ega:DAC",
          "title": "Example Genomics Data Access Committee",
          "description": "Committee responsible for reviewing controlled-access requests for the Example Genomics programme.",
          "status": "released",
          "contactPoint": [
            {
              "@type": "cv:ContactPoint",
              "email": "dac@example.org"
            }
          ],
          "components": [
            {
              "@type": "org:Membership",
              "agent": {
                "@type": [
                  "prov:Agent",
                  "prov:Person"
                ],
                "name": "Jane Doe",
                "givenName": "Jane",
                "familyName": "Doe",
                "email": "jane.doe@example.org"
              },
              "roles": [
                "main_contact",
                "administrator"
              ]
            }
          ]
        }
      ]
    },

    "entitySchemaDatafile": {
      "type": "object",
      "title": "Datafile entity validation",
      "if": {
        "allOf": [
          { "$ref": "#/$defs/declaresDatafile" },
          { "$ref": "#/$defs/routableEntityType" }
