          }
        }
      ]
    },

    "entitySchemaDAC": {
      "type": "object",
      "title": "Dac entity validation",
      "if": {
        "allOf": [
          { "$ref": "#/$defs/declaresDAC" },
          { "$ref": "#/$defs/routableEntityType" }
